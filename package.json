{
  "name": "en-blanco",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "RPG tactico narrativo de terror psicologico en pantalla dividida.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @en-blanco/server",
    "dev:client": "npm run dev --workspace @en-blanco/client",
    "dev:server": "npm run dev --workspace @en-blanco/server",
    "build": "npm run build --workspace @en-blanco/shared && npm run build --workspace @en-blanco/client && npm run build --workspace @en-blanco/server",
    "start": "npm run start --workspace @en-blanco/server",
    "lint": "eslint .",
    "test": "npm run test:e2e",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  },
  "engines": {
    "node": ">=20"
  }
}
